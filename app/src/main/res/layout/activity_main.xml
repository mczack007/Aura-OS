<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14">

    <!-- High-Resolution Ambient Sci-Fi Core Background -->
    <ImageView
        android:id="@+id/img_ambient_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/aura_bg" />

    <!-- Interactive Lower HUD Layer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Boot / Enter Engine Button -->
        <TextView
            android:id="@+id/btn_initialize_aura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3300E5FF"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="INITIALIZE AURA OS"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SYSTEM STATUS // OPTIMAL"
            android:textColor="#8000FFC5"
            android:textSize="10sp"
            android:letterSpacing="0.2" />
    </LinearLayout>

</RelativeLayout>

