<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOICE SPECTRUM CONSOLE"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Continuous Neural Full-Duplex Listening"
        android:textColor="#546E7A"
        android:textSize="12sp" />

    <!-- Waveform Visualizer Display Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginVertical="30dp"
        android:background="#101926"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <View
            android:layout_width="6dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="#00FFC5" />

        <View
            android:layout_width="6dp"
            android:layout_height="80dp"
            android:layout_marginHorizontal="4dp"
            android:background="#00E5FF" />

        <View
            android:layout_width="6dp"
            android:layout_height="110dp"
            android:layout_marginHorizontal="4dp"
            android:background="#00FFC5" />

        <View
            android:layout_width="6dp"
            android:layout_height="60dp"
            android:layout_marginHorizontal="4dp"
            android:background="#00E5FF" />

        <View
            android:layout_width="6dp"
            android:layout_height="95dp"
            android:layout_marginHorizontal="4dp"
            android:background="#00FFC5" />

        <View
            android:layout_width="6dp"
            android:layout_height="35dp"
            android:layout_marginHorizontal="4dp"
            android:background="#00E5FF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvVoiceBuffer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIC STREAM: ACTIVE // 16kHz PCM"
        android:textColor="#00FFC5"
        android:textSize="13sp" />

</LinearLayout>
