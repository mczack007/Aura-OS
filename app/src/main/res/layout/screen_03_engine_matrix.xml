<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="17-ENGINE HEALTH MATRIX"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Live status of all core subsystems"
            android:textColor="#546E7A"
            android:textSize="12sp" />

        <!-- Engine Status Rows -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101926"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="[01] Full-Duplex Voice Engine: ONLINE"
            android:textColor="#00FFC5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101926"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="[02] Self-Healing Fault Core: ACTIVE"
            android:textColor="#00FFC5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101926"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="[03] Predictive Pre-Action: STANDBY"
            android:textColor="#FFB300"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101926"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="[04] Local File Indexer: READY"
            android:textColor="#00FFC5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101926"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:text="[05] P2P Swarm Mesh: SCANNING"
            android:textColor="#00E5FF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#101926"
            android:padding="12dp"
            android:text="[06-17] Secondary Daemons: ARMED"
            android:textColor="#90A4AE"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
