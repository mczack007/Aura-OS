<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THERMAL &amp; RESOURCE GOVERNOR"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Hardware throttling &amp; adaptive power budgeting"
        android:textColor="#546E7A"
        android:textSize="12sp" />

    <!-- Thermal & Battery Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101926"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARDWARE THERMAL PROFILES"
            android:textColor="#00FFC5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="SoC Core Temp: 34.8°C (Optimal)\nBattery Thermal Level: 31.2°C\nThrottling State: NONE (100% Clock Budget)\nGovernor Mode: LOW_LATENCY_BURST"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Memory & Execution Allocation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#101926"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEAP ALLOCATION &amp; SWAP"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Active Aura Heap: 82 MB\nSystem Available RAM: 3.4 GB / 8.0 GB\nzRAM Compression: Enabled (Ratio: 2.8:1)"
            android:textColor="#90A4AE"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
