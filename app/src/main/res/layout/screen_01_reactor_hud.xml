<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Central Arc Reactor Core -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="#101926">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AURA CORE\nONLINE"
            android:textAlignment="center"
            android:textColor="#00FFC5"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Telemetry Cards -->
    <TextView
        android:id="@+id/tvEngineSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="17 AUTONOMOUS ENGINES ACTIVE"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLiveStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Continuous full-duplex listening armed.\nScreen 01 of 15 loaded."
        android:textColor="#90A4AE"
        android:textSize="13sp" />

</LinearLayout>
