<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14">

    <ImageView
        android:id="@+id/img_hardware_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_hardware_console" />

    <!-- Back to Dashboard Trigger -->
    <View
        android:id="@+id/btn_back_to_dashboard"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Hardware Media Volume Slider Overlay -->
    <SeekBar
        android:id="@+id/slider_master_volume"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:rotation="270"
        android:alpha="0.0" />

</RelativeLayout>
