<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEURAL SECURITY VAULT"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Hardware-backed cryptographic keystore &amp; zero-trust gate"
        android:textColor="#546E7A"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101926"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CRYPTOGRAPHIC STATUS"
            android:textColor="#00FFC5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Keystore: AndroidKeyStore (StrongBox/TEE)\nEncryption: AES-256-GCM + ChaCha20\nZero-Trust Status: ENFORCED\nAudit Ledger: Tamper-Evident SHA-256"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#101926"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTECTED SECRETS"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="[+] Neural Engine Model Weights\n[+] Mesh P2P Private Identity Keys\n[+] Local Vector Embedding Index"
            android:textColor="#90A4AE"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
