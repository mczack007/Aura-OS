<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INTENT APP DISPATCHER"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="Deep package routing &amp; autonomous app control"
        android:textColor="#546E7A"
        android:textSize="12sp" />

    <!-- Active Routing Tunnel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101926"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PACKAGE INTEGRATION MATRIX"
            android:textColor="#00FFC5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Target: com.android.camera2 (Direct Pipe)\nIntent Action: ACTION_IMAGE_CAPTURE_SECURE\nExecution State: ZERO_UI_DISPATCH (Background Arm)"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Discovered Target Packages -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#101926"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOUND APPLICATION SUBSYSTEMS"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="[+] Audio Hardware HAL / OpenSL ES Bridge\n[+] Telephony &amp; SMS Provider Hooks\n[+] Media Session Controller &amp; Transport Bus\n[+] Accessibility Automation Dispatcher"
            android:textColor="#90A4AE"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
